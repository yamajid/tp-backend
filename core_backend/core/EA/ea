            } else if(orderTypeFilter == "LIMIT_BUY" && orderType == ORDER_TYPE_BUY_LIMIT) {
               matchesType = true;
            } else if(orderTypeFilter == "LIMIT_SELL" && orderType == ORDER_TYPE_SELL_LIMIT) {
               matchesType = true;
            } else if(orderTypeFilter == "STOP_BUY" && orderType == ORDER_TYPE_BUY_STOP) {
