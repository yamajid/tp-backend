//+------------------------------------------------------------------+
//| Helper: Ensure symbol is selected and subscribed                 |
//+------------------------------------------------------------------+
bool EnsureSymbol(string symbol) {
   // Try to select the symbol
   if(!SymbolSelect(symbol, true)) {
      int error = GetLastError();
      Print("ERROR: Failed to select symbol: ", symbol, " (Error: ", error, ")");
      
      // List similar symbols to help diagnose
      Print("  Searching for similar symbols...");
      int total = SymbolsTotal(false);  // All symbols in Market Watch
      int found = 0;
      for(int i = 0; i < total && found < 5; i++) {
         string available = SymbolName(i, false);
         if(StringFind(available, StringSubstr(symbol, 0, 3)) >= 0) {
            Print("    - Found in Market Watch: ", available);
            found++;
         }
      }
      
      if(found == 0) {
         Print("  No similar symbols in Market Watch. Checking all broker symbols...");
         int totalAll = SymbolsTotal(true);  // All available from broker
         for(int i = 0; i < totalAll && found < 5; i++) {
            string available = SymbolName(i, true);
            if(StringFind(available, StringSubstr(symbol, 0, 3)) >= 0) {
               Print("    - Available from broker: ", available, " (not in Market Watch)");
               found++;
            }
         }
      }
      
      return false;
   }
   
   // Verify symbol is visible
   if(!SymbolInfoInteger(symbol, SYMBOL_SELECT)) {
      Print("ERROR: Symbol not available: ", symbol);
      return false;
   }
   
   Print("✓ Symbol verified: ", symbol);
   return true;
}

//+------------------------------------------------------------------+
//| Send broker symbol metadata to hub (PDF requirement)             |
//+------------------------------------------------------------------+
void SendSymbolMetadata() {
   int total = SymbolsTotal(true);
   string metadata = "SYMBOLS|SESSION_ID=" + SessionID + "|DATA=[";
   int count = 0;
   
   for(int i = 0; i < total; i++) {
      string symbol = SymbolName(i, true);
      if(StringLen(symbol) == 0) continue;
      
      string path = SymbolInfoString(symbol, SYMBOL_PATH);
      string description = SymbolInfoString(symbol, SYMBOL_DESCRIPTION);
      double contractSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_CONTRACT_SIZE);
      
      if(count > 0) metadata += ",";
      
      metadata += "{SYMBOL=" + symbol + 
                  "|PATH=" + path + 
                  "|DESC=" + description + 
                  "|CONTRACT=" + DoubleToString(contractSize, 2) + "}";
      count++;
   }
   
   metadata += "]|\n";
   SendToHub(metadata);
}

