   Print("Sent delete acknowledgment: ", deletedCount, " orders deleted");
}

//+------------------------------------------------------------------+
//| Process PARTIAL_CLOSE command                                    |
//+------------------------------------------------------------------+
void ProcessPartialClose(string message) {
   long magic = StringToInteger(GetField(message, "MAGIC"));
   ulong positionID = StringToInteger(GetField(message, "POSITION_ID"));
   if(positionID == 0) positionID = StringToInteger(GetField(message, "position_id"));
   
   double closePercent = StringToDouble(GetField(message, "CLOSE_PERCENT"));
   if(closePercent == 0) closePercent = StringToDouble(GetField(message, "close_percent"));
   
   // Accept both uppercase and lowercase filter keys (PDF compliance)
   string symbolFilter = GetField(message, "SYMBOL");
   if(symbolFilter == "") symbolFilter = GetField(message, "symbol");
   
   string pnlFilter = GetField(message, "PNL");
   if(pnlFilter == "") pnlFilter = GetField(message, "pnl");
   StringToUpper(pnlFilter);
   
   string sideFilter = GetField(message, "SIDE");
   if(sideFilter == "") sideFilter = GetField(message, "side");
   StringToUpper(sideFilter);
   
   string scope = GetField(message, "SCOPE");
   if(scope == "") scope = GetField(message, "scope");
   StringToUpper(scope);
   
   Print("Partial closing positions: Magic=", magic, " PositionID=", positionID, " ClosePercent=", closePercent, " Symbol=", symbolFilter, " PnL=", pnlFilter, " Side=", sideFilter, " Scope=", scope);
   
   if(magic == 0 || closePercent <= 0 || closePercent > 100) {
      Print("ERROR: Invalid magic or close percent");
      string ack = "ACK|PARTIAL_CLOSE|COUNT=0|STATUS=ERROR|REASON=Invalid parameters|\n";
      SendToHub(ack);
      return;
   }
   
   // Set magic number for trade operations
   trade.SetExpertMagicNumber(magic);
   
   int partialClosedCount = 0;
   
   if(positionID > 0) {
      // Close specific position
      if(PositionSelectByTicket(positionID)) {
         long posMagic = PositionGetInteger(POSITION_MAGIC);
         if(posMagic == magic) {
            string symbol = PositionGetString(POSITION_SYMBOL);
            double currentVolume = PositionGetDouble(POSITION_VOLUME);
            double volumeToClose = (closePercent / 100.0) * currentVolume;
            
            // Enforce volume rules
            volumeToClose = NormalizeVolume(symbol, volumeToClose);
            
            // Validate minimum lot
            double minLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
            if(volumeToClose < minLot) {
               Print("✗ Close volume ", volumeToClose, " below minimum lot ", minLot);
               string ack = "ACK|PARTIAL_CLOSE|COUNT=0|STATUS=ERROR|REASON=MIN_LOT_VIOLATION|\n";
               SendToHub(ack);
               return;
            }
            
            // Ensure symbol is properly selected and market data is available
            if(!EnsureSymbol(symbol)) {
               Print("✗ Failed to ensure symbol: ", symbol);
               string ack = "ACK|PARTIAL_CLOSE|COUNT=0|STATUS=ERROR|REASON=SYMBOL_NOT_AVAILABLE|\n";
               SendToHub(ack);
               return;
            }
            
            // Set deviation for this operation (critical for market execution)
            trade.SetDeviationInPoints(10);
            
            if(volumeToClose > 0) {
               if(trade.PositionClosePartial(positionID, volumeToClose)) {
                  partialClosedCount++;
            }
         }
      }
   } else {
      // Close all matching positions
      for(int i = PositionsTotal() - 1; i >= 0; i--) {
         if(PositionGetTicket(i) > 0) {
            // Capture ALL position data immediately while position is selected
            long posMagic = PositionGetInteger(POSITION_MAGIC);
            string posSymbol = PositionGetString(POSITION_SYMBOL);
            double posProfit = PositionGetDouble(POSITION_PROFIT);
            long posType = PositionGetInteger(POSITION_TYPE);
            ulong ticket = PositionGetInteger(POSITION_TICKET);
            double currentVolume = PositionGetDouble(POSITION_VOLUME);
            
            // Filter by magic
            if(posMagic != magic) continue;
            
            // Apply filters
            if(symbolFilter != "" && posSymbol != symbolFilter) continue;
            if(pnlFilter != "" && pnlFilter == "PROFIT" && posProfit <= 0) continue;
            if(pnlFilter != "" && pnlFilter == "LOSS" && posProfit >= 0) continue;
            if(sideFilter != "" && sideFilter == "BUY" && posType != POSITION_TYPE_BUY) continue;
            if(sideFilter != "" && sideFilter == "SELL" && posType != POSITION_TYPE_SELL) continue;
            
            // Calculate volume to close
            double volumeToClose = (closePercent / 100.0) * currentVolume;
            
            // Enforce volume rules
            volumeToClose = NormalizeVolume(posSymbol, volumeToClose);
            
            // Validate minimum lot
            double minLot = SymbolInfoDouble(posSymbol, SYMBOL_VOLUME_MIN);
            if(volumeToClose < minLot) {
               Print("✗ Close volume ", volumeToClose, " below minimum lot ", minLot, " for position ", ticket);
               continue;
            }
            
            if(volumeToClose > 0) {
               // Ensure symbol is properly selected and market data is available
               if(!EnsureSymbol(posSymbol)) {
                  Print("✗ Failed to ensure symbol: ", posSymbol, " for position ", ticket);
                  continue;
               }
               
               // Set deviation for this operation (critical for market execution)
               trade.SetDeviationInPoints(10);
               
               // Re-select position by ticket to ensure valid context
               if(!PositionSelectByTicket(ticket)) continue;
               
               bool success = false;
               uint retcode = 0;
               
               // Determine opposite direction
               if(posType == POSITION_TYPE_BUY) {
                  // Current position is BUY, open SELL to reduce net
                  success = trade.Sell(volumeToClose, posSymbol, 0, 0, 0, "PartialClose:" + IntegerToString(ticket));
               } else {
                  // Current position is SELL, open BUY to reduce net
                  success = trade.Buy(volumeToClose, posSymbol, 0, 0, 0, "PartialClose:" + IntegerToString(ticket));
               }
               
               retcode = trade.ResultRetcode();
               
               // Check CTrade result code
               if(success || retcode == TRADE_RETCODE_DONE) {
                  partialClosedCount++;
               }
            }
         }
      }
   }
   
   // Send acknowledgment
   string ack = "ACK|PARTIAL_CLOSE|COUNT=" + IntegerToString(partialClosedCount) + "|STATUS=OK|\n";
   SendToHub(ack);
   Print("Sent partial close acknowledgment: ", partialClosedCount, " positions partial closed");
}

//+------------------------------------------------------------------+
//| Process kill switch command                                      |
//+------------------------------------------------------------------+
void ProcessKillSwitch(string message) {
   string action = GetField(message, "ACTION");
   
   if(action == "HALT") {
      killSwitchActive = true;
      killSwitchState = "HALTED";
      Print("Kill switch activated: HALT - rejecting new orders");
   }
   else if(action == "FLATTEN") {
      killSwitchActive = true;
      killSwitchState = "FLATTENING";
      Print("Kill switch activated: FLATTEN - closing all positions and canceling all orders");
      long magic = StringToInteger(GetField(message, "MAGIC"));
      CloseAllPositions(magic);
      CancelAllOrders(magic);
   }
   else if(action == "RESUME") {
      killSwitchActive = false;
      killSwitchState = "NORMAL";
      Print("Kill switch deactivated: RESUME - normal trading resumed");
   }
   else {
      Print("WARNING: Unknown kill switch action: ", action);
   }
   
   // Send acknowledgment
   string ack = "KILL_SWITCH_ACK|STATE=" + killSwitchState + "|STATUS=OK|\n";
   SendToHub(ack);
}

//+------------------------------------------------------------------+
//| Close all positions with specified magic number                  |
//+------------------------------------------------------------------+
void CloseAllPositions(long targetMagic) {
   int total = PositionsTotal();
   int closedCount = 0;
   
   for(int i = total - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0) {
         long posMagic = PositionGetInteger(POSITION_MAGIC);
         
         // Only close positions with matching magic
         if(posMagic == targetMagic) {
            string symbol = PositionGetString(POSITION_SYMBOL);
            ENUM_POSITION_TYPE type = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
            
            if(trade.PositionClose(ticket)) {
               closedCount++;
               Print("✓ Closed position: ", ticket, " Symbol: ", symbol, " Type: ", EnumToString(type));
            } else {
               Print("✗ Failed to close position: ", ticket, " Error: ", GetLastError());
            }
         }
      }
   }
   
   Print("Closed ", closedCount, " positions with magic: ", targetMagic);
}

//+------------------------------------------------------------------+
//| Cancel all pending orders with specified magic number            |
//+------------------------------------------------------------------+
void CancelAllOrders(long targetMagic) {
   int total = OrdersTotal();
   int canceledCount = 0;
   
   for(int i = total - 1; i >= 0; i--) {
      ulong ticket = OrderGetTicket(i);
      if(ticket > 0) {
         long orderMagic = OrderGetInteger(ORDER_MAGIC);
         
         // Only cancel orders with matching magic
         if(orderMagic == targetMagic) {
            string symbol = OrderGetString(ORDER_SYMBOL);
            ENUM_ORDER_TYPE type = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
            
            if(trade.OrderDelete(ticket)) {
               canceledCount++;
               Print("✓ Canceled order: ", ticket, " Symbol: ", symbol, " Type: ", EnumToString(type));
            } else {
               Print("✗ Failed to cancel order: ", ticket, " Error: ", GetLastError());
            }
         }
      }
   }
    
   Print("Canceled ", canceledCount, " orders with magic: ", targetMagic);
}