   string symbolFilter = GetField(message, "SYMBOL");
   if(symbolFilter == "") symbolFilter = GetField(message, "symbol");
   
   string orderTypeFilter = GetField(message, "ORDER_TYPE");
   if(orderTypeFilter == "") orderTypeFilter = GetField(message, "order_type");
   StringToUpper(orderTypeFilter);
   
   string scope = GetField(message, "SCOPE");
   if(scope == "") scope = GetField(message, "scope");
   StringToUpper(scope);
   
   Print("Deleting orders: Magic=", magic, " Symbol=", symbolFilter, " OrderType=", orderTypeFilter, " Scope=", scope);
   
   if(magic == 0) {
      Print("ERROR: Invalid magic number");
      return;
   }
   
   // Set magic number for trade operations (CRITICAL FIX)
   trade.SetExpertMagicNumber(magic);
   
   int deletedCount = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--) {
      if(OrderGetTicket(i) > 0) {
         long orderMagic = OrderGetInteger(ORDER_MAGIC);
         if(orderMagic != magic) continue; // Filter by magic
         
         // Apply symbol filter
         if(symbolFilter != "" && OrderGetString(ORDER_SYMBOL) != symbolFilter) continue;
         
         // Apply order type filter
         if(orderTypeFilter != "") {
            ENUM_ORDER_TYPE orderType = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
            bool matchesType = false;
            
            if(orderTypeFilter == "LIMIT" && (orderType == ORDER_TYPE_BUY_LIMIT || orderType == ORDER_TYPE_SELL_LIMIT)) {
               matchesType = true;
            } else if(orderTypeFilter == "STOP" && (orderType == ORDER_TYPE_BUY_STOP || orderType == ORDER_TYPE_SELL_STOP)) {
