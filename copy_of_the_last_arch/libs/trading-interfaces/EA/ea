// State persistence
string stateFile = "ea_state.txt";

//+------------------------------------------------------------------+
//| Helper: Ensure symbol is selected and subscribed                 |
//+------------------------------------------------------------------+
bool EnsureSymbol(string symbol) {
   if(!SymbolSelect(symbol, true)) {
      Print("ERROR: Failed to select symbol: ", symbol, " (Error: ", GetLastError(), ")");
      return false;
   }
   
   // Verify symbol is visible
   if(!SymbolInfoInteger(symbol, SYMBOL_SELECT)) {
      Print("ERROR: Symbol not available: ", symbol);
      return false;
   }
   
   return true;
}

//+------------------------------------------------------------------+
//| Send broker symbol metadata to hub (PDF requirement)             |
//+------------------------------------------------------------------+
void SendSymbolMetadata() {
   Print("Sending broker symbol metadata...");
   
   string metadata = "SYMBOLS|SESSION_ID=" + SessionID + "|DATA=[";
   
   int total = SymbolsTotal(false); // All symbols available to broker
   int count = 0;
   
   for(int i = 0; i < total; i++) { // Iterate through all symbols
      string symbol = SymbolName(i, false);
      
      if(StringLen(symbol) == 0) continue;
      
      // Get symbol info
      string path = SymbolInfoString(symbol, SYMBOL_PATH);
      string description = SymbolInfoString(symbol, SYMBOL_DESCRIPTION);
      double contractSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_CONTRACT_SIZE);
      
      if(count > 0) metadata += ",";
      
      metadata += "{SYMBOL=" + symbol + 
                  "|PATH=" + path + 
                  "|DESC=" + description + 
                  "|CONTRACT=" + DoubleToString(contractSize, 2) + "}";
      count++;
   }
   
   metadata += "]|\n";
   
   SendToHub(metadata);
   Print("✓ Sent metadata for ", count, " symbols");
}

//+------------------------------------------------------------------+
//| Send account info to hub                                         |
//+------------------------------------------------------------------+
void SendAccountInfo() {
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   double profit = AccountInfoDouble(ACCOUNT_PROFIT);
   double margin = AccountInfoDouble(ACCOUNT_MARGIN);
   double margin_free = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
   
   string accountData = "ACCOUNT|SESSION_ID=" + SessionID + 
                       "|BALANCE=" + DoubleToString(balance, 2) +
                       "|EQUITY=" + DoubleToString(equity, 2) +
                       "|PROFIT=" + DoubleToString(profit, 2) +
                       "|MARGIN=" + DoubleToString(margin, 2) +
                       "|MARGIN_FREE=" + DoubleToString(margin_free, 2) + "|\n";
   
   SendToHub(accountData);
   Print("✓ Sent account info: Balance=", DoubleToString(balance, 2), ", Equity=", DoubleToString(equity, 2));
}

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit() {
   Print("=== MT5 Bridge EA Starting ===");
   
   // Fixed session ID for testing
   SessionID = "ea_00";
   Print("Session ID: ", SessionID);
   
   // Create socket
   socket = SocketCreate();
   if(socket == INVALID_HANDLE) {
      Print("ERROR: Failed to create socket: ", GetLastError());
      return INIT_FAILED;
   }
   
   // Connect to MT5 Hub
   Print("Connecting to MT5 Hub at ", HubAddress, ":", HubPort);
   if(!SocketConnect(socket, HubAddress, HubPort, 5000)) {
      Print("ERROR: Failed to connect to MT5 Hub: ", GetLastError());
      SocketClose(socket);
      return INIT_FAILED;
   }
   
   Print("Connected to MT5 Hub successfully");
   
   // Send HELLO handshake message
   string hello = "HELLO;session_id=" + SessionID + "\n";
   if(!SendToHub(hello)) {
      Print("ERROR: Failed to send HELLO handshake");
      SocketClose(socket);
      return INIT_FAILED;
   }
   
   Print("Handshake sent.");
   
   // Send broker symbol metadata to hub (PDF requirement)
   SendSymbolMetadata();
   
   // Send account info to hub
   SendAccountInfo();
   
   Print("EA is ready to receive orders.");
   
   // Initialize heartbeat
   lastPingReceived = TimeCurrent();
   
   // Load previous state if available
   LoadState();
   
   // Start timer to check for hub messages (every 100ms for responsiveness)
   EventSetTimer(1);
   
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Expert deinitialization function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason) {
   Print("=== MT5 Bridge EA Stopping ===");
   Print("Reason: ", reason);
   
   // Close socket
   if(socket != INVALID_HANDLE) {
      SocketClose(socket);
      socket = INVALID_HANDLE;
   }
   
   EventKillTimer();
   Print("EA stopped successfully");
}

//+------------------------------------------------------------------+
//| Trade transaction event handler                                  |
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction& trans,
                       const MqlTradeRequest& request,
                       const MqlTradeResult& result) {
   
   // Detect when pending order is filled and becomes position
   if(trans.type == TRADE_TRANSACTION_ORDER_DELETE && 
      trans.order_state == ORDER_STATE_FILLED) {
      
      // Get the original order to extract ClientOrderID from comment
      if(OrderSelect(trans.order)) {
         string comment = OrderGetString(ORDER_COMMENT);
         string clientOrderId = "";
         
         // Extract ClientOrderID from comment "Order:BENCH_abc123"
         if(StringFind(comment, "Order:") == 0) {
            clientOrderId = StringSubstr(comment, 6); // Skip "Order:"
         }
         
         if(StringLen(clientOrderId) > 0 && trans.position > 0) {
            // Send state change notification to hub
            string stateChange = "STATE_CHANGE|SESSION_ID=" + SessionID +
                               "|CLIENT_ORDER_ID=" + clientOrderId +
                               "|OLD_TICKET=" + IntegerToString(trans.order) +
                               "|NEW_TICKET=" + IntegerToString(trans.position) +
                               "|NEW_STATE=POSITION|\n";
            
            SendToHub(stateChange);
            Print("→ Order→Position transition: ", clientOrderId, 
                  " Ticket ", trans.order, "→", trans.position);
         }
      }
   }
   
   // Save state after any trade transaction
   SaveState();
   
   // Update account info after any trade transaction
   // SendAccountInfo();  // Removed: now sent every second in OnTimer()
}

//+------------------------------------------------------------------+
//| Timer function - polls for incoming messages from hub            |
//+------------------------------------------------------------------+
void OnTimer() {
   static int saveCounter = 0; // Counter for periodic state saving
   
   // Check if socket is still valid
   if(socket == INVALID_HANDLE) {
      // Attempt reconnection with exponential backoff
      datetime now = TimeCurrent();
      if(now - lastConnectionAttempt >= backoffDelay) {
         if(reconnectionAttempts < maxReconnectionAttempts) {
            Print("Attempting reconnection... Attempt ", reconnectionAttempts + 1, "/", maxReconnectionAttempts);
            
            // Create socket
            socket = SocketCreate();
            if(socket != INVALID_HANDLE) {
               // Connect to MT5 Hub
               if(SocketConnect(socket, HubAddress, HubPort, 5000)) {
                  Print("Reconnected to MT5 Hub successfully");
                  
                  // Send HELLO handshake message
                  string hello = "HELLO;session_id=" + SessionID + "\n";
                  if(SendToHub(hello)) {
                     // Send broker symbol metadata and account info
                     SendSymbolMetadata();
                     SendAccountInfo();
                     
                     // Reset reconnection variables
                     reconnectionAttempts = 0;
                     backoffDelay = 1; // Reset to 1 second
                     
                     // Initialize heartbeat
                     lastPingReceived = now;
                     
                     // Load state after reconnection
                     LoadState();
                     
                     // Send reconnection acknowledgment
                     string reconnectAck = "RECONNECTED|SESSION_ID=" + SessionID + "|STATUS=OK|\n";
                     SendToHub(reconnectAck);
                     
                     Print("Reconnection complete, EA ready to receive orders");
                  } else {
                     Print("ERROR: Failed to send HELLO on reconnection");
                     SocketClose(socket);
                     socket = INVALID_HANDLE;
                  }
               } else {
                  Print("ERROR: Failed to reconnect to MT5 Hub: ", GetLastError());
                  SocketClose(socket);
                  socket = INVALID_HANDLE;
               }
            } else {
               Print("ERROR: Failed to create socket for reconnection: ", GetLastError());
            }
            
            if(socket == INVALID_HANDLE) {
               reconnectionAttempts++;
               backoffDelay = MathMin(backoffDelay * 2, 300); // Exponential backoff, max 5 minutes
               Print("Reconnection failed, attempt ", reconnectionAttempts, "/", maxReconnectionAttempts, 
                     ", next attempt in ", backoffDelay, " seconds");
            }
            
            lastConnectionAttempt = now;
         } else {
            Print("Max reconnection attempts reached (", maxReconnectionAttempts, "), stopping reconnection attempts");
         }
      }
      return;
   }
      
   // Check for stale connection (no PING received within timeout)
   datetime now = TimeCurrent();
   if(lastPingReceived > 0 && now - lastPingReceived > pingTimeout) {
      Print("WARNING: No PING received within ", pingTimeout, " seconds, marking connection stale");
      SocketClose(socket);
      socket = INVALID_HANDLE;
   }
   
   // Check for incoming messages
   uchar buffer[4096];
   uint bytes = SocketIsReadable(socket);
   
   if(bytes > 0) {
      int received = SocketRead(socket, buffer, MathMin(bytes, 4095), 100);
      
      if(received > 0) {
         buffer[received] = 0; // Null terminate
         string chunk = CharArrayToString(buffer);
         
         // Append to receive buffer
         receiveBuffer += chunk;
         
         // Process all complete messages (separated by \n)
         ProcessMessages();
      }
      else if(received == 0) {
         Print("WARNING: Hub closed connection");
         SocketClose(socket);
         socket = INVALID_HANDLE;
         // Reconnection will be attempted on next OnTimer call
      }
      else {
         Print("ERROR: SocketRead error: ", GetLastError(), " - closing connection");
         SocketClose(socket);
         socket = INVALID_HANDLE;
      }
   }
   
   // Send account info every second
   SendAccountInfo();
   
   // Periodic state saving (every 60 seconds)
   saveCounter++;
   if(saveCounter >= 60) {
      SaveState();
      saveCounter = 0;
   }
}

//+------------------------------------------------------------------+
//| Process all complete messages in the receive buffer              |
//+------------------------------------------------------------------+
void ProcessMessages() {
   int pos = StringFind(receiveBuffer, "\n");
   
   while(pos >= 0) {
      // Extract one complete message
      string message = StringSubstr(receiveBuffer, 0, pos);
      
      // Remove processed message from buffer
      receiveBuffer = StringSubstr(receiveBuffer, pos + 1);
      
      // Trim whitespace
      StringTrimLeft(message);
      StringTrimRight(message);
      
      if(StringLen(message) > 0) {
         Print("← Received: ", message);
         ProcessCommand(message);
      }
      
      // Look for next message
      pos = StringFind(receiveBuffer, "\n");
   }
}

//+------------------------------------------------------------------+
//| Process command from MT5 Hub                                     |
//+------------------------------------------------------------------+
void ProcessCommand(string command) {
   // Identify message type
   if(StringFind(command, "SEND_ORDER|") == 0) {
      ProcessSendOrder(command);
   }
   else if(StringFind(command, "MODIFY_ORDER|") == 0) {
      ProcessModifyOrder(command);
   }
   else if(StringFind(command, "CANCEL_ORDER|") == 0) {
      ProcessCancelOrder(command);
   }
   else if(StringFind(command, "CLOSE_POSITIONS|") == 0) {
      ProcessClosePositions(command);
   }
   else if(StringFind(command, "DELETE_ORDERS|") == 0) {
      ProcessDeleteOrders(command);
   }
   else if(StringFind(command, "PARTIAL_CLOSE|") == 0) {
      ProcessPartialClose(command);
   }
   else if(StringFind(command, "PING") == 0) {
      // Respond to heartbeat and update last ping time
      lastPingReceived = TimeCurrent();
      SendToHub("PONG\n");
   }
   else {
      Print("WARNING: Unknown command type: ", command);
   }
}

//+------------------------------------------------------------------+
//| Helper: Send message to hub                                      |
//+------------------------------------------------------------------+
bool SendToHub(string message) {
   if(socket == INVALID_HANDLE) {
      Print("ERROR: Cannot send - socket invalid");
      return false;
   }
   
   uchar buffer[];
   StringToCharArray(message, buffer);
   int sent = SocketSend(socket, buffer, ArraySize(buffer) - 1);
   
   if(sent <= 0) {
      Print("ERROR: SocketSend failed: ", GetLastError(), " - closing connection");
      SocketClose(socket);
      socket = INVALID_HANDLE;
      return false;
   }
   
   Print("→ Sent: ", message);
   return true;
}

//+------------------------------------------------------------------+
//| Helper: Parse key=value fields from message                      |
//+------------------------------------------------------------------+
string GetField(string message, string key) {
   int start = StringFind(message, key + "=");
   if(start == -1) return "";
   start += StringLen(key) + 1; // Skip key and =
   int end = StringFind(message, "|", start);
   if(end == -1) end = StringLen(message);
   return StringSubstr(message, start, end - start);
}

//+------------------------------------------------------------------+
//| Send confirmation message to hub                                 |
//+------------------------------------------------------------------+
void SendConfirmation(string clientOrderId, string status, ulong ticket = 0, 
                      double filledPrice = 0.0, string reason = "", 
                      int errorCode = 0, string orderState = "") {
   string confirmation = "CONFIRMATION|SESSION_ID=" + SessionID + 
                         "|CLIENT_ORDER_ID=" + clientOrderId +
                         "|STATUS=" + status;
   
   if(ticket > 0)
      confirmation += "|TICKET=" + IntegerToString(ticket);
   
   if(filledPrice > 0.0)
      confirmation += "|FILLED_PRICE=" + DoubleToString(filledPrice, 5);
   
   if(StringLen(orderState) > 0)
      confirmation += "|ORDER_STATE=" + orderState;
   
   if(StringLen(reason) > 0)
      confirmation += "|REASON=" + reason;
   
   if(errorCode != 0)
      confirmation += "|ERROR_CODE=" + IntegerToString(errorCode);
   
   confirmation += "|\n";
   
   SendToHub(confirmation);
}

//+------------------------------------------------------------------+
//| Helper: Normalize volume to symbol's lot rules                  |
//+------------------------------------------------------------------+
double NormalizeVolume(string symbol, double volume) {
   double minLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
   
   if(volume < minLot) return 0;
   if(volume > maxLot) volume = maxLot;
   
   // Round to lot step
   volume = MathRound(volume / lotStep) * lotStep;
   
   if(volume < minLot) return 0;
   
   return volume;
}

//+------------------------------------------------------------------+
//| Save current state to file                                       |
//+------------------------------------------------------------------+
void SaveState() {
   int file = FileOpen(stateFile, FILE_WRITE | FILE_TXT);
   if(file == INVALID_HANDLE) {
      Print("ERROR: Cannot open state file for writing: ", stateFile);
      return;
   }
   
   // Save timestamp
   FileWrite(file, "TIMESTAMP=" + TimeToString(TimeCurrent()));
   
   // Save account info
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   FileWrite(file, "ACCOUNT|BALANCE=" + DoubleToString(balance, 2) + "|EQUITY=" + DoubleToString(equity, 2));
   
   // Save positions
   int posTotal = PositionsTotal();
   string posData = "POSITIONS|COUNT=" + IntegerToString(posTotal);
   for(int i = 0; i < posTotal; i++) {
      if(PositionGetTicket(i) > 0) {
         ulong ticket = PositionGetInteger(POSITION_TICKET);
         string symbol = PositionGetString(POSITION_SYMBOL);
         double volume = PositionGetDouble(POSITION_VOLUME);
         long magic = PositionGetInteger(POSITION_MAGIC);
         posData += "|" + IntegerToString(ticket) + "," + symbol + "," + DoubleToString(volume, 2) + "," + IntegerToString(magic);
      }
   }
   FileWrite(file, posData);
   
   // Save orders
   int ordTotal = OrdersTotal();
   string ordData = "ORDERS|COUNT=" + IntegerToString(ordTotal);
   for(int i = 0; i < ordTotal; i++) {
      if(OrderGetTicket(i) > 0) {
         ulong ticket = OrderGetInteger(ORDER_TICKET);
         string symbol = OrderGetString(ORDER_SYMBOL);
         double volume = OrderGetDouble(ORDER_VOLUME_INITIAL);
         long magic = OrderGetInteger(ORDER_MAGIC);
         ordData += "|" + IntegerToString(ticket) + "," + symbol + "," + DoubleToString(volume, 2) + "," + IntegerToString(magic);
      }
   }
   FileWrite(file, ordData);
   
   FileClose(file);
   Print("State saved to ", stateFile);
}

