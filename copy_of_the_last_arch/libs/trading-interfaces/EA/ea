// MT5 Hub connection settings
string HubAddress = "127.0.0.1";
int HubPort = 5556;

// Session ID - unique identifier for this EA instance
string SessionID = "";

// Socket handle
int socket = INVALID_HANDLE;

// Receive buffer for handling partial messages
string receiveBuffer = "";

// Reconnection variables
