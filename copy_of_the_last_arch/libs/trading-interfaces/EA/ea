   Print("Deleting orders: Magic=", magic, " Scope=", scope);
   
   if(magic == 0) {
      Print("ERROR: Invalid magic number");
      return;
   }
   
   int deletedCount = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--) {
      if(OrderGetTicket(i) > 0) {
         long orderMagic = OrderGetInteger(ORDER_MAGIC);
         if(orderMagic != magic) continue; // Filter by magic
         
         // Delete order
         ulong ticket = OrderGetTicket(i);
         if(trade.OrderDelete(ticket)) {
            deletedCount++;
            Print("✓ Deleted order: ", ticket);
         } else {
            Print("✗ Failed to delete order: ", ticket);
         }
      }
   }
   
   // Send acknowledgment
   string ack = "ACK|DELETE_ORDERS|COUNT=" + IntegerToString(deletedCount) + "|STATUS=OK|\n";
   SendToHub(ack);
   Print("Sent delete acknowledgment: ", deletedCount, " orders deleted");
}

//+------------------------------------------------------------------+
//| Process PARTIAL_CLOSE command                                    |
//+------------------------------------------------------------------+
void ProcessPartialClose(string message) {
   long magic = StringToInteger(GetField(message, "MAGIC"));
   ulong positionID = StringToInteger(GetField(message, "POSITION_ID"));
   double closePercent = StringToDouble(GetField(message, "CLOSE_PERCENT"));
   string pnlFilter = GetField(message, "PNL");
   string sideFilter = GetField(message, "SIDE");
   string scope = GetField(message, "SCOPE");
   
   Print("Partial closing positions: Magic=", magic, " PositionID=", positionID, " ClosePercent=", closePercent, " PnL=", pnlFilter, " Side=", sideFilter, " Scope=", scope);
   
   if(magic == 0 || closePercent <= 0 || closePercent > 100) {
      Print("ERROR: Invalid magic or close percent");
      string ack = "ACK|PARTIAL_CLOSE|COUNT=0|STATUS=ERROR|REASON=Invalid parameters|\n";
      SendToHub(ack);
      return;
   }
   
   int partialClosedCount = 0;
   
   if(positionID > 0) {
      // Close specific position
      if(PositionSelectByTicket(positionID)) {
         long posMagic = PositionGetInteger(POSITION_MAGIC);
         if(posMagic == magic) {
            string symbol = PositionGetString(POSITION_SYMBOL);
            double currentVolume = PositionGetDouble(POSITION_VOLUME);
            double volumeToClose = (closePercent / 100.0) * currentVolume;
            
            // Enforce volume rules
            volumeToClose = NormalizeVolume(symbol, volumeToClose);
            
            if(volumeToClose > 0 && trade.PositionClosePartial(positionID, volumeToClose)) {
               partialClosedCount++;
               Print("✓ Partial closed position: ", positionID, " Volume: ", volumeToClose);
            } else {
               Print("✗ Failed to partial close position: ", positionID);
            }
         }
      }
   } else {
      // Close all matching positions
      for(int i = PositionsTotal() - 1; i >= 0; i--) {
         if(PositionGetTicket(i) > 0) {
            long posMagic = PositionGetInteger(POSITION_MAGIC);
            if(posMagic != magic) continue;
            
            // Apply filters
            if(pnlFilter != "" && pnlFilter == "PROFIT" && PositionGetDouble(POSITION_PROFIT) <= 0) continue;
            if(pnlFilter != "" && pnlFilter == "LOSS" && PositionGetDouble(POSITION_PROFIT) >= 0) continue;
            if(sideFilter != "" && sideFilter == "BUY" && PositionGetInteger(POSITION_TYPE) != POSITION_TYPE_BUY) continue;
            if(sideFilter != "" && sideFilter == "SELL" && PositionGetInteger(POSITION_TYPE) != POSITION_TYPE_SELL) continue;
            
            ulong ticket = PositionGetInteger(POSITION_TICKET);
            string symbol = PositionGetString(POSITION_SYMBOL);
            double currentVolume = PositionGetDouble(POSITION_VOLUME);
            double volumeToClose = (closePercent / 100.0) * currentVolume;
            
            // Enforce volume rules
            volumeToClose = NormalizeVolume(symbol, volumeToClose);
            
            if(volumeToClose > 0 && trade.PositionClosePartial(ticket, volumeToClose)) {
               partialClosedCount++;
               Print("✓ Partial closed position: ", ticket, " Volume: ", volumeToClose);
            } else {
               Print("✗ Failed to partial close position: ", ticket);
            }
         }
      }
   }
   
   // Send acknowledgment
   string ack = "ACK|PARTIAL_CLOSE|COUNT=" + IntegerToString(partialClosedCount) + "|STATUS=OK|\n";
   SendToHub(ack);
   Print("Sent partial close acknowledgment: ", partialClosedCount, " positions partial closed");
}