//+------------------------------------------------------------------+
//| Process SEND_ORDER command                                       |
//+------------------------------------------------------------------+
void ProcessSendOrder(string message) {
   string clientOrderId = GetField(message, "CLIENT_ORDER_ID");
   string symbol = GetField(message, "SYMBOL");
   string orderTypeStr = GetField(message, "ORDER_TYPE");
   double volume = StringToDouble(GetField(message, "VOLUME"));
   double price = StringToDouble(GetField(message, "PRICE"));
   double sl = StringToDouble(GetField(message, "SL"));
   double tp = StringToDouble(GetField(message, "TP"));
   long magic = StringToInteger(GetField(message, "MAGIC"));
   
   Print("Processing order: ", clientOrderId, " ", orderTypeStr, " ", symbol, " ", volume, " Magic: ", magic);
   
   // Validate inputs
   if(StringLen(clientOrderId) == 0 || StringLen(symbol) == 0 || volume <= 0.0 || magic == 0) {
      SendConfirmation(clientOrderId, "REJECTED", 0, 0.0, "Invalid order parameters or magic number");
      return;
   }
   
   // Ensure symbol is subscribed before trading
   if(!EnsureSymbol(symbol)) {
      SendConfirmation(clientOrderId, "REJECTED", 0, 0.0, "Symbol not available: " + symbol);
      return;
   }
   
   // Set magic number for this trade
   trade.SetExpertMagicNumber(magic);
   
   // Execute order based on type
   bool result = false;
   
   if(orderTypeStr == "MARKET_BUY") {
      result = trade.Buy(volume, symbol, 0, sl, tp, "Order:" + clientOrderId);
   }
   else if(orderTypeStr == "MARKET_SELL") {
      result = trade.Sell(volume, symbol, 0, sl, tp, "Order:" + clientOrderId);
   }
   else if(orderTypeStr == "LIMIT_BUY") {
      result = trade.BuyLimit(volume, price, symbol, sl, tp, ORDER_TIME_GTC, 0, "Order:" + clientOrderId);
   }
   else if(orderTypeStr == "LIMIT_SELL") {
      result = trade.SellLimit(volume, price, symbol, sl, tp, ORDER_TIME_GTC, 0, "Order:" + clientOrderId);
   }
   else if(orderTypeStr == "STOP_BUY") {
      result = trade.BuyStop(volume, price, symbol, sl, tp, ORDER_TIME_GTC, 0, "Order:" + clientOrderId);
   }
   else if(orderTypeStr == "STOP_SELL") {
      result = trade.SellStop(volume, price, symbol, sl, tp, ORDER_TIME_GTC, 0, "Order:" + clientOrderId);
   }
   else {
      SendConfirmation(clientOrderId, "REJECTED", 0, 0.0, "Unknown order type: " + orderTypeStr);
      return;
   }
   
   // Send confirmation
   if(result) {
      ulong ticket = 0;
      double filledPrice = trade.ResultPrice();
      string orderState = "";
      
      // For market orders, get the position ticket by selecting the most recent position
      if(orderTypeStr == "MARKET_BUY" || orderTypeStr == "MARKET_SELL") {
         // Find position by symbol and comment
         string searchComment = "Order:" + clientOrderId;
         for(int i = PositionsTotal() - 1; i >= 0; i--) {
            if(PositionGetTicket(i) > 0) {
               if(PositionGetString(POSITION_SYMBOL) == symbol && 
                  StringFind(PositionGetString(POSITION_COMMENT), clientOrderId) >= 0) {
                  ticket = PositionGetInteger(POSITION_TICKET);
                  break;
               }
            }
         }
         // Fallback to deal ticket if position not found
         if(ticket == 0) ticket = trade.ResultDeal();
         
         orderState = "POSITION";
      }
      else {
         // For pending orders, use order ticket
         ticket = trade.ResultOrder();
         orderState = "ORDER";
      }
      
      Print("✓ Order executed successfully. Ticket: ", ticket, " State: ", orderState, " (Deal: ", trade.ResultDeal(), ", Order: ", trade.ResultOrder(), ")");
      SendConfirmation(clientOrderId, "FILLED", ticket, filledPrice, "", 0, orderState);
   }
   else {
      int errorCode = GetLastError();
      string errorDesc = trade.ResultRetcodeDescription();
      
      Print("✗ Order failed: ", errorDesc, " (", errorCode, ")");
      SendConfirmation(clientOrderId, "REJECTED", 0, 0.0, errorDesc, errorCode);
   }
}

//+------------------------------------------------------------------+
//| Process MODIFY_ORDER command                                     |
//+------------------------------------------------------------------+
void ProcessModifyOrder(string message) {
   string clientOrderId = GetField(message, "CLIENT_ORDER_ID");
   ulong ticket = StringToInteger(GetField(message, "TICKET_ID"));
   
   double newSL = -1.0;
   double newTP = -1.0;
   string slStr = GetField(message, "SL");
   if (slStr != "") {
      newSL = StringToDouble(slStr);
   }
   string tpStr = GetField(message, "TP");
   if (tpStr != "") {
      newTP = StringToDouble(tpStr);
   }
   
   Print("=== MODIFY DEBUG ===");
   Print("Modifying order: ", clientOrderId, " Ticket: ", ticket, " SL: ", newSL, " TP: ", newTP);
   
   if(ticket == 0) {
      SendConfirmation(clientOrderId, "REJECTED", 0, 0.0, "Invalid ticket ID");
      return;
   }
   
   // Debug: List all open positions
   Print("Total positions: ", PositionsTotal());
   for(int i = 0; i < PositionsTotal(); i++) {
      ulong posTicket = PositionGetTicket(i);
      string posSymbol = PositionGetString(POSITION_SYMBOL);
      Print("  Position[", i, "]: Ticket=", posTicket, " Symbol=", posSymbol);
   }
   
   bool result = false;
   string orderState = "";
   
   // Check if it's an open position
   if(PositionSelectByTicket(ticket)) {
      Print("✓ Found as POSITION, attempting modify...");
      string posSymbol = PositionGetString(POSITION_SYMBOL);
      Print("  Position Symbol: ", posSymbol);
      
      // Ensure symbol is subscribed before modifying
      if(!EnsureSymbol(posSymbol)) {
         SendConfirmation(clientOrderId, "REJECTED", ticket, 0.0, "Symbol not available: " + posSymbol);
         return;
      }
      
      double currentSL = PositionGetDouble(POSITION_SL);
      double currentTP = PositionGetDouble(POSITION_TP);
      double modifySL = (newSL != -1.0) ? newSL : currentSL;
      double modifyTP = (newTP != -1.0) ? newTP : currentTP;
      
      result = trade.PositionModify(ticket, modifySL, modifyTP);
      orderState = "POSITION";
   }
   // Check if it's a pending order
   else if(OrderSelect(ticket)) {
      Print("✓ Found as PENDING ORDER, attempting modify...");
      // Get current order info
      string orderSymbol = OrderGetString(ORDER_SYMBOL);
      double orderPrice = OrderGetDouble(ORDER_PRICE_OPEN);
      ENUM_ORDER_TYPE orderType = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      datetime expiration = (datetime)OrderGetInteger(ORDER_TIME_EXPIRATION);
      
      // Ensure symbol is subscribed before modifying
      if(!EnsureSymbol(orderSymbol)) {
         SendConfirmation(clientOrderId, "REJECTED", ticket, 0.0, "Symbol not available: " + orderSymbol);
         return;
      }
      
      // Modify pending order (price, SL, TP)
      result = trade.OrderModify(ticket, orderPrice, newSL, newTP, ORDER_TIME_GTC, expiration);
      orderState = "ORDER";
   }
   else {
      Print("✗ Ticket ", ticket, " not found as position or order!");
      Print("  Tried PositionSelectByTicket: false");
      Print("  Tried OrderSelect: false");
      SendConfirmation(clientOrderId, "REJECTED", ticket, 0.0, "Ticket not found");
      return;
   }
   
   if(result) {
      Print("✓ Modify successful. State: ", orderState);
      SendConfirmation(clientOrderId, "MODIFIED", ticket, 0.0, "Order/Position modified", 0, orderState);
   }
   else {
      string errorDesc = trade.ResultRetcodeDescription();
      Print("✗ Modify failed: ", errorDesc);
      SendConfirmation(clientOrderId, "REJECTED", ticket, 0.0, errorDesc, GetLastError());
   }
}

//+------------------------------------------------------------------+
//| Process CANCEL_ORDER command                                     |
//+------------------------------------------------------------------+
void ProcessCancelOrder(string message) {
   string clientOrderId = GetField(message, "CLIENT_ORDER_ID");
   ulong ticket = StringToInteger(GetField(message, "TICKET_ID"));
   
   Print("Canceling order: ", clientOrderId, " Ticket: ", ticket);
   
   if(ticket == 0) {
      SendConfirmation(clientOrderId, "REJECTED", 0, 0.0, "Invalid ticket ID");
      return;
   }
   
   bool result = false;
   string orderState = "";
   
   // Check if it's an open position - close it
   if(PositionSelectByTicket(ticket)) {
      string posSymbol = PositionGetString(POSITION_SYMBOL);
      
      // Ensure symbol is subscribed before closing
      if(!EnsureSymbol(posSymbol)) {
         SendConfirmation(clientOrderId, "REJECTED", ticket, 0.0, "Symbol not available: " + posSymbol);
         return;
      }
      
      result = trade.PositionClose(ticket);
      orderState = "POSITION";
   }
   // Check if it's a pending order - delete it
   else if(OrderSelect(ticket)) {
      string orderSymbol = OrderGetString(ORDER_SYMBOL);
      
      // Ensure symbol is subscribed before deleting
      if(!EnsureSymbol(orderSymbol)) {
         SendConfirmation(clientOrderId, "REJECTED", ticket, 0.0, "Symbol not available: " + orderSymbol);
         return;
      }
      
      result = trade.OrderDelete(ticket);
      orderState = "ORDER";
   }
   else {
      SendConfirmation(clientOrderId, "REJECTED", ticket, 0.0, "Ticket not found");
      return;
   }
   
   if(result) {
      Print("✓ ", (orderState == "POSITION" ? "Position closed" : "Order deleted"), " successfully. State: ", orderState);
      SendConfirmation(clientOrderId, "CANCELED", ticket, 0.0, (orderState == "POSITION" ? "Position closed" : "Order deleted"), 0, orderState);
   }
   else {
      string errorDesc = trade.ResultRetcodeDescription();
      Print("✗ ", (orderState == "POSITION" ? "Close position" : "Delete order"), " failed: ", errorDesc);
      SendConfirmation(clientOrderId, "REJECTED", ticket, 0.0, errorDesc, GetLastError());
   }
}

//+------------------------------------------------------------------+
//| Process CLOSE_POSITIONS command                                  |
//+------------------------------------------------------------------+
void ProcessClosePositions(string message) {
   long magic = StringToInteger(GetField(message, "MAGIC"));
   string pnlFilter = GetField(message, "PNL");
   string sideFilter = GetField(message, "SIDE");
   string scope = GetField(message, "SCOPE");
   
   Print("Closing positions: Magic=", magic, " PnL=", pnlFilter, " Side=", sideFilter, " Scope=", scope);
   
   if(magic == 0) {
      Print("ERROR: Invalid magic number");
      return;
   }
   
   int closedCount = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      if(PositionGetTicket(i) > 0) {
         long posMagic = PositionGetInteger(POSITION_MAGIC);
         if(posMagic != magic) continue; // Filter by magic
         
         // Apply filters
         if(pnlFilter != "" && pnlFilter == "PROFIT" && PositionGetDouble(POSITION_PROFIT) <= 0) continue;
         if(pnlFilter != "" && pnlFilter == "LOSS" && PositionGetDouble(POSITION_PROFIT) >= 0) continue;
         if(sideFilter != "" && sideFilter == "BUY" && PositionGetInteger(POSITION_TYPE) != POSITION_TYPE_BUY) continue;
         if(sideFilter != "" && sideFilter == "SELL" && PositionGetInteger(POSITION_TYPE) != POSITION_TYPE_SELL) continue;
         
         // Close position
         ulong ticket = PositionGetInteger(POSITION_TICKET);
         if(trade.PositionClose(ticket)) {
            closedCount++;
            Print("✓ Closed position: ", ticket);
         } else {
            Print("✗ Failed to close position: ", ticket);
         }
      }
   }
   
   // Send acknowledgment
   string ack = "ACK|CLOSE_POSITIONS|COUNT=" + IntegerToString(closedCount) + "|STATUS=OK|\n";
   SendToHub(ack);
   Print("Sent close acknowledgment: ", closedCount, " positions closed");
}

